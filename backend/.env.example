# Leave blank to run the sync against built-in mock data (no network calls,
# no key required). Set to a real key from https://openstates.org/account/profile/
# to sync live data instead -- no code changes needed either way.
OPENSTATES_API_KEY=
DATABASE_URL=sqlite:///./legislator_directory.db
SYNC_ADMIN_TOKEN=dev-sync-token
SYNC_INTERVAL_HOURS=24
